<?xml version="1.0"?>
<launch>
    <!-- BundleSDF Node Launch File -->

    <!-- RealSense camera topics (default values) -->
    <arg name="color_topic" default="/camera/color/image_raw"/>
    <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="camera_info_topic" default="/camera/color/camera_info"/>

    <!-- BundleSDF parameters -->
    <arg name="output_dir" default="/tmp/bundlesdf_output"/>
    <arg name="use_segmenter" default="false"/>
    <arg name="use_gui" default="false"/>
    <arg name="shorter_side" default="480"/>
    <arg name="frame_stride" default="1"/>
    <arg name="debug_level" default="2"/>

    <!-- Frame IDs -->
    <arg name="camera_frame_id" default="camera_color_optical_frame"/>
    <arg name="object_frame_id" default="tracked_object"/>

    <!-- BundleSDF Node -->
    <node name="bundlesdf_node" pkg="bundlesdf" type="bundlesdf_node.py" output="screen">
        <!-- Topic remappings -->
        <param name="color_topic" value="$(arg color_topic)"/>
        <param name="depth_topic" value="$(arg depth_topic)"/>
        <param name="camera_info_topic" value="$(arg camera_info_topic)"/>

        <!-- Parameters -->
        <param name="output_dir" value="$(arg output_dir)"/>
        <param name="use_segmenter" value="$(arg use_segmenter)"/>
        <param name="use_gui" value="$(arg use_gui)"/>
        <param name="shorter_side" value="$(arg shorter_side)"/>
        <param name="frame_stride" value="$(arg frame_stride)"/>
        <param name="debug_level" value="$(arg debug_level)"/>

        <!-- Frame IDs -->
        <param name="camera_frame_id" value="$(arg camera_frame_id)"/>
        <param name="object_frame_id" value="$(arg object_frame_id)"/>
    </node>

</launch>
