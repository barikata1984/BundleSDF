<launch>
  <!-- Combined entry point: sam3_segmenter (optional) + bundlesdf_node.
       Both nodes run in this same container (docker/ros-one.dockerfile
       bundles SAM 3's deps alongside the tracker). -->
  <arg name="use_segmenter" default="true" />
  <arg name="target_object" default="object" />

  <arg name="camera_config" default="$(find bundlesdf_node)/config/camera_input.yaml" />
  <arg name="target_frame" default="tracked_object" />
  <arg name="out_folder" default="/tmp/bundlesdf_online" />
  <arg name="debug_level" default="1" />
  <arg name="use_gui" default="false" />
  <arg name="check_segmentation" default="true" />

  <include file="$(find sam3_segmenter)/launch/sam3_segmenter.launch" if="$(arg use_segmenter)">
    <arg name="text_prompt" value="$(arg target_object)" />
    <arg name="camera_config" value="$(arg camera_config)" />
    <arg name="check_segmentation" value="$(arg check_segmentation)" />
  </include>

  <include file="$(find bundlesdf_node)/launch/bundlesdf_node.launch">
    <arg name="camera_config" value="$(arg camera_config)" />
    <arg name="target_frame" value="$(arg target_frame)" />
    <arg name="out_folder" value="$(arg out_folder)" />
    <arg name="debug_level" value="$(arg debug_level)" />
    <arg name="use_gui" value="$(arg use_gui)" />
  </include>
</launch>
